DATABASE_URL=postgresql+psycopg://homelab:homelab_dev_password@localhost:5432/homelab_dashboard
FLASK_SECRET_KEY=replace-with-a-long-random-value
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:5000/auth/callback
ALLOW_INSECURE_DEV_AUTH=false
# Comma-separated trusted administrators; required in production.
ALLOWED_GOOGLE_EMAILS=
FLASK_ENV=development
SCHEDULER_ENABLED=true
CHECK_TIMEOUT_SECONDS=10
SESSION_COOKIE_SECURE=false
